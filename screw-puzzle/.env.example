# Copy this template to .env.local and replace the placeholders there.
# Keep real project settings in .env.local, which is ignored by Git.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Public Turnstile site key. Keep its secret key only in Supabase CAPTCHA settings.
# VITE_TURNSTILE_SITE_KEY=your_public_turnstile_site_key

# Existing two-player endpoint, when configured for an online deployment:
# VITE_ROOM_SERVER=wss://screw-cottage-rooms.onrender.com/rooms

# The future trusted ranked-run service needs separate server-only settings.
# Put SUPABASE_SECRET_KEY in Render's secret environment, never a VITE_ value.
